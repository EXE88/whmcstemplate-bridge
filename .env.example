# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Tehran

# Frontend origins allowed to call this API (Next.js / SPA)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# sqlite for local, postgres for production
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://bridge:bridge@127.0.0.1:5432/bridge

# ---------------------------------------------------------------------------
# Cache / Broker (optional in dev - falls back to locmem / eager tasks)
# ---------------------------------------------------------------------------
REDIS_URL=
# REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ---------------------------------------------------------------------------
# WHMCS connection  <-- everything about the WHMCS box lives here
# ---------------------------------------------------------------------------
# Scheme + host + (optional) port of the WHMCS server. IP is fine.
WHMCS_SCHEME=https
WHMCS_HOST=whmcs.example.com
WHMCS_PORT=443
# Path of the WHMCS installation root (empty when installed on the domain root)
WHMCS_BASE_PATH=
# API endpoint relative to the base path. WHMCS >= 8: /includes/api.php
WHMCS_API_PATH=/includes/api.php

# Send a Host header different from WHMCS_HOST (useful when talking to a raw IP
# behind a vhost). Leave empty to skip.
WHMCS_HOST_HEADER=

# --- credentials (NEVER exposed to the frontend) ---
WHMCS_IDENTIFIER=
WHMCS_SECRET=
# Optional: value of $api_access_key in WHMCS configuration.php.
# Lets the bridge call the API from a non-whitelisted IP.
WHMCS_ACCESS_KEY=

# Legacy admin user/password auth (only if you cannot create API credentials).
# When set, they are used *instead of* identifier/secret.
WHMCS_ADMIN_USERNAME=
WHMCS_ADMIN_PASSWORD=

# --- transport tuning ---
WHMCS_TIMEOUT=15
WHMCS_CONNECT_TIMEOUT=5
WHMCS_MAX_RETRIES=2
WHMCS_RETRY_BACKOFF=0.4
WHMCS_VERIFY_SSL=True
# Extra CA bundle path when WHMCS uses a self-signed certificate
WHMCS_CA_BUNDLE=
WHMCS_MAX_CONNECTIONS=20

# ---------------------------------------------------------------------------
# Auth (JWT issued by this bridge - WHMCS never sees these tokens)
# ---------------------------------------------------------------------------
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
JWT_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Throttling (DRF scoped rates)
# ---------------------------------------------------------------------------
THROTTLE_ANON=30/min
THROTTLE_USER=120/min
# per (IP, account): protects one account from being hammered
THROTTLE_LOGIN=8/min
# per IP across all accounts: stops credential stuffing
THROTTLE_LOGIN_IP=20/min
THROTTLE_WRITE=20/min

# ---------------------------------------------------------------------------
# Caching TTLs (seconds) - 0 disables that cache
# ---------------------------------------------------------------------------
CACHE_TTL_CATALOGUE=900
CACHE_TTL_CLIENT=60
CACHE_TTL_INVOICES=45
CACHE_TTL_TICKETS=30

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_WHMCS_PAYLOADS=False
SENTRY_DSN=

# Serve /api/docs/ and /api/schema/ on a non-DEBUG deployment. Off by default:
# the schema is a full map of the API surface.
EXPOSE_API_DOCS=False

# Number of reverse proxies in front of this service (nginx, Cloudflare, ...).
# 0 = none, and X-Forwarded-For is then ignored entirely because a client can
# forge it. Set it correctly or client IPs and IP throttling will be wrong.
NUM_PROXIES=0
