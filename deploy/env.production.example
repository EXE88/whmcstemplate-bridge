# /srv/whmcs-bridge/.env   -   chmod 600, owned by the bridge user.
# Generate fresh keys on the server; never reuse the development ones:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=__generate_on_the_server__
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.lithiumhost.ir
DJANGO_TIME_ZONE=Asia/Tehran

# The storefront origin(s) - exactly the scheme+host the browser uses.
CORS_ALLOWED_ORIGINS=https://lithiumhost.ir,https://www.lithiumhost.ir
CSRF_TRUSTED_ORIGINS=https://lithiumhost.ir,https://www.lithiumhost.ir

# CRITICAL: number of reverse proxies in front of gunicorn.
# nginx only            -> 1
# Cloudflare + nginx    -> 2
# Wrong value = every client looks like 127.0.0.1, so the per-IP login limiter
# becomes one global bucket and client IPs sent to WHMCS are useless.
NUM_PROXIES=1

DATABASE_URL=postgres://bridge:__db_password__@127.0.0.1:5432/bridge

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=django-db

# --- WHMCS -----------------------------------------------------------------
WHMCS_SCHEME=https
WHMCS_HOST=lithiumhost.ir
WHMCS_PORT=443
WHMCS_BASE_PATH=
WHMCS_API_PATH=/includes/api.php
WHMCS_HOST_HEADER=
WHMCS_IDENTIFIER=__from_whmcs_admin__
WHMCS_SECRET=__from_whmcs_admin__
# Only needed while this server's IP is not in the WHMCS API whitelist.
WHMCS_ACCESS_KEY=
WHMCS_TIMEOUT=15
WHMCS_CONNECT_TIMEOUT=5
WHMCS_MAX_RETRIES=2
WHMCS_VERIFY_SSL=True
WHMCS_MAX_CONNECTIONS=20

# --- Auth ------------------------------------------------------------------
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
JWT_SIGNING_KEY=__generate_on_the_server__

# --- Payments (Zibal) ------------------------------------------------------
# Public origin of THIS service; Zibal returns the browser here.
PAYMENT_CALLBACK_BASE_URL=https://api.lithiumhost.ir
PAYMENT_RESULT_URL=https://lithiumhost.ir/checkout/result
# 1 = WHMCS stores rial, 10 = WHMCS stores toman. CHECK THIS AGAINST A REAL
# INVOICE BEFORE TAKING PAYMENTS - a wrong value bills 10x or 1/10x.
PAYMENT_AMOUNT_MULTIPLIER=1
ZIBAL_MERCHANT=__real_merchant_id__
ZIBAL_TIMEOUT=20
ZIBAL_VERIFY_RETRIES=2

# --- Throttling ------------------------------------------------------------
THROTTLE_ANON=30/min
THROTTLE_USER=120/min
THROTTLE_LOGIN=8/min
THROTTLE_LOGIN_IP=20/min
THROTTLE_WRITE=20/min

# --- Attachments -----------------------------------------------------------
ATTACHMENT_MAX_FILES=5
ATTACHMENT_MAX_MB_EACH=5
ATTACHMENT_MAX_MB_TOTAL=15
ATTACHMENT_ALLOWED_EXTENSIONS=

# --- Caching ---------------------------------------------------------------
CACHE_TTL_CATALOGUE=900
CACHE_TTL_CLIENT=60
CACHE_TTL_INVOICES=45
CACHE_TTL_TICKETS=30

# --- Observability ---------------------------------------------------------
LOG_LEVEL=INFO
# Keep off: payload logs contain customer PII.
LOG_WHMCS_PAYLOADS=False
SENTRY_DSN=
# Keep off in production: the schema maps the whole API surface.
EXPOSE_API_DOCS=False

# --- gunicorn --------------------------------------------------------------
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=90
