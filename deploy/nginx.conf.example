# /etc/nginx/sites-available/api.lithiumhost.ir
#
# Terminates TLS and proxies to gunicorn on 127.0.0.1:8000.
# Run `certbot --nginx -d api.lithiumhost.ir` to fill in the certificate paths.

upstream whmcs_bridge {
    server 127.0.0.1:8000 fail_timeout=0;
}

server {
    listen 80;
    listen [::]:80;
    server_name api.lithiumhost.ir;

    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.lithiumhost.ir;

    ssl_certificate     /etc/letsencrypt/live/api.lithiumhost.ir/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.lithiumhost.ir/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;

    # Ticket attachments allow 15MB per message; leave room for the multipart
    # envelope or nginx rejects the upload with 413 before Django sees it.
    client_max_body_size 20m;
    client_body_timeout 60s;

    # Upstream WHMCS calls can take seconds - do not cut them short.
    proxy_read_timeout 90s;
    proxy_send_timeout 90s;
    proxy_connect_timeout 10s;

    location / {
        proxy_pass http://whmcs_bridge;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # SECURE_PROXY_SSL_HEADER depends on this; without it Django thinks the
        # request is plaintext and SECURE_SSL_REDIRECT loops.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_redirect off;
        proxy_buffering off;
    }

    # Kubernetes/uptime probes; no need to log them.
    location = /api/v1/health/ {
        proxy_pass http://whmcs_bridge;
        access_log off;
    }

    location /static/ {
        alias /srv/whmcs-bridge/staticfiles/;
        expires 30d;
        access_log off;
    }
}
