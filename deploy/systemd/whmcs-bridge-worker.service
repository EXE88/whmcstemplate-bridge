[Unit]
Description=WHMCS Bridge Celery worker
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=bridge
Group=bridge
WorkingDirectory=/srv/whmcs-bridge
EnvironmentFile=/srv/whmcs-bridge/.env
ExecStart=/srv/whmcs-bridge/.venv/bin/celery -A config worker \
    --loglevel=info --concurrency=4 -Q default,provisioning,sync
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/whmcs-bridge

[Install]
WantedBy=multi-user.target
