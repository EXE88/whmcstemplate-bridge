[Unit]
Description=WHMCS Bridge API (gunicorn)
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=notify
User=bridge
Group=bridge
WorkingDirectory=/srv/whmcs-bridge
EnvironmentFile=/srv/whmcs-bridge/.env
ExecStart=/srv/whmcs-bridge/.venv/bin/gunicorn config.wsgi:application \
    --config /srv/whmcs-bridge/deploy/gunicorn.conf.py
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=40

# Hardening: the service only needs to read its own directory and reach the
# network. It never writes outside /srv/whmcs-bridge.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/whmcs-bridge
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
